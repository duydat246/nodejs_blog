<div class='mt-4'>
  <h3>My courses</h3>
  <table class='table mt-4'>
    <thead>
      <tr>
        <th scope='col'>#</th>
        <th scope='col'>Courses name</th>
        <th scope='col'>Level</th>
        <th scope='col'>Created time</th>
        <th scope='col' colspan='2'>Updated time</th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
        <tr>
          <th scope='row'>{{sum @index 1}}</th>
          <td>{{this.name}}</td>
          <td>{{this.level}}</td>
          <td>{{this.createdAt}}</td>
          <td>{{this.updatedAt}}</td>
          <td>
            <a href='/courses/{{this._id}}/edit' class='btn btn-link'>Edit</a>
            <a
              class='btn btn-link'
              data-bs-toggle='modal'
              data-bs-target='#exampleModal'
              data-id='{{this._id}}'
            >
              Delete
            </a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<div id='exampleModal' class='modal fade' tabindex='-1'>
  <div class='modal-dialog'>
    <div class='modal-content'>
      <div class='modal-header'>
        <h5 class='modal-title'>Delete Course</h5>
        <button
          type='button'
          class='btn-close'
          data-bs-dismiss='modal'
          aria-label='Close'
        ></button>
      </div>
      <div class='modal-body'>
        <p>Are you sure to delete this course ?</p>
      </div>
      <div class='modal-footer'>
        <button
          type='button'
          class='btn btn-secondary'
          data-bs-dismiss='modal'
        >Cancel</button>
        <button
          id='delete-course'
          type='button'
          class='btn btn-danger'
        >Delete</button>
      </div>
    </div>
  </div>
</div>

<form name='delete-course-form' method='POST'></form>

<script>
  let courseId; const exampleModal = document.getElementById('exampleModal');
  let deleteCourseForm = document.forms["delete-course-form"]; if(exampleModal)
  { exampleModal.addEventListener('show.bs.modal', function (event) { const
  button = event.relatedTarget; const id = button.getAttribute('data-id');
  courseId = id; } ) } let btnDeleteCourse =
  document.getElementById("delete-course"); console.log(btnDeleteCourse);
  btnDeleteCourse.onclick = function() { console.log(courseId);
  deleteCourseForm.action = '/courses/' + courseId + '?_method=DELETE';
  deleteCourseForm.submit(); }
</script>